{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://falochron.local/schemas/extraction.schema.json",
  "title": "FALOCHRON extraction output v0.1",
  "description": "The subset of event.schema.json that the SLM emits under grammar enforcement. Every key is required so the output shape is deterministic; unknown values are null (or UNKNOWN for enums). source/provenance/correlation/needs_human_review are added deterministically afterwards and are NOT part of this schema. Definitions are copied verbatim from event.schema.json — keep them in sync (tests check this).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_type",
    "warning_id",
    "issued_at",
    "valid_from",
    "valid_to",
    "geometry",
    "location_name",
    "agency",
    "entities"
  ],
  "properties": {
    "event_type": { "$ref": "#/definitions/event_type" },
    "warning_id": { "$ref": "#/definitions/nullable_string" },
    "issued_at": { "$ref": "#/definitions/nullable_utc" },
    "valid_from": { "$ref": "#/definitions/nullable_utc" },
    "valid_to": { "$ref": "#/definitions/nullable_utc" },
    "geometry": { "$ref": "#/definitions/geometry" },
    "location_name": { "$ref": "#/definitions/nullable_string" },
    "agency": { "$ref": "#/definitions/nullable_string" },
    "entities": { "$ref": "#/definitions/entities" }
  },
  "definitions": {
    "event_type": {
      "description": "S-124 warningType. UNKNOWN when the source does not allow classification.",
      "type": "string",
      "enum": [
        "NAV_WARNING",
        "MET_WARNING",
        "EXERCISE",
        "INFRA_DAMAGE",
        "WRECK",
        "OBSTRUCTION",
        "VOICE_REPORT",
        "OTHER",
        "UNKNOWN"
      ]
    },
    "nullable_string": { "type": ["string", "null"] },
    "nullable_utc": {
      "description": "UTC timestamp, ISO 8601 with Z; null when not stated in the source. Written as a pattern (not format) so llama.cpp's grammar converter can enforce it.",
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "position": {
      "description": "GeoJSON position [longitude, latitude] in decimal degrees (WGS84).",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ]
    },
    "geometry": {
      "description": "GeoJSON geometry (S-124 Point/Curve/Surface). null when only a place name is given.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Point" },
            "coordinates": { "$ref": "#/definitions/position" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "LineString" },
            "coordinates": { "type": "array", "minItems": 2, "items": { "$ref": "#/definitions/position" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": { "const": "Polygon" },
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "array", "minItems": 4, "items": { "$ref": "#/definitions/position" } }
            }
          }
        }
      ]
    },
    "entities": {
      "description": "Named things mentioned in the source, used by the correlator's 'common entities' rule (PRD F7). Text is copied verbatim from the source.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text"],
        "properties": {
          "type": { "type": "string", "enum": ["VESSEL", "MMSI", "CALLSIGN", "INFRA", "AID_TO_NAV", "OTHER"] },
          "text": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
